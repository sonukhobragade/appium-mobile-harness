# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# Nothing here has a working default baked into the code. That is deliberate:
# a committed fallback credential stays valid long after everyone has forgotten
# it is there.

# ── Target environment ────────────────────────────────────────────────────
# Base URL of the API under test. No default: these helpers create and then
# delete users, so a forgotten value must fail rather than pick somewhere.
API_BASE_URL=

# The base URL that is safe to create and destroy accounts against. When this
# equals API_BASE_URL the suite may generate throwaway phone numbers; otherwise
# TEST_PHONE_NUMBER must be set explicitly.
QA_BASE_URL=

# ── Test user ─────────────────────────────────────────────────────────────
# The account these tests log in as. They CREATE and then DELETE this account,
# so outside a throwaway environment this must be a number you own.
TEST_PHONE_NUMBER=

# Fixed OTP for demo/test users. Environment specific. Do not commit a real one.
TEST_OTP=

# SMS auto-read hash sent with the OTP trigger. App specific.
OTP_AUTO_READ_HASH=

# Push token used in the verify payload. Any valid-shaped token works.
TEST_FCM_TOKEN=

# Token accepted by the account deletion endpoint. Leave unset to use a JWT
# obtained through the normal login path instead.
DELETE_AUTH_TOKEN=

# ── Appium ────────────────────────────────────────────────────────────────
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_SERVER_URL=
APPIUM_AUTO_START=true
APPIUM_HEARTBEAT_INTERVAL=30

# ── Device ────────────────────────────────────────────────────────────────
PLATFORM=android
DEVICE_PROVIDER=local
ANDROID_SERIAL=
DEVICE_UDID=
DEVICE_ID_PRIMARY=
APP_PACKAGE=com.example.app
APP_ACTIVITY=
ANDROID_APP_PACKAGE=com.example.app

# ── Cloud device providers (optional) ─────────────────────────────────────
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
LT_USERNAME=
LT_ACCESS_KEY=

# ── Waits ─────────────────────────────────────────────────────────────────
EXPLICIT_WAIT_SECONDS=20
FLUENT_WAIT_POLL_FREQUENCY=0.5

# ── Reporting and notifications ───────────────────────────────────────────
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
ALLURE_REPORT_URL=

# ── Optional AI-assisted self-healing locators ────────────────────────────
SELF_HEAL=false
ANTHROPIC_API_KEY=

